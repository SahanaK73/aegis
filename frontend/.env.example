# Base URL for the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# 'false' (default) = Live API mode. Set to 'true' only for the clearly-labelled Mock/Demo mode.
VITE_USE_MOCK=false

# DEVELOPMENT-ONLY tenant token (matches backend/config.py defaults). Anything in a VITE_ variable
# is visible in the browser, so never put a real secret here.
VITE_API_TOKEN=dev-token-tenant-a

# Live refresh interval in milliseconds
VITE_REFRESH_MS=5000
